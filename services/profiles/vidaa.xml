<?xml version="1.0" encoding="utf-8"?>
<Client name="vidaa">
  <!--
    Hisense VIDAA Smart TV — Plex for VIDAA (app 5.94.4).

    Why this file exists:
    On transcode requests the app sends X-Plex-Platform: vidaa and a
    X-Plex-Client-Profile-Extra that asks for hls/mpegts with
    h264,mpeg2video + aac,ac3,eac3,mp2 — but it does NOT send
    X-Plex-Client-Profile-Name. Plex then looks up a profile named after
    the platform. With no vidaa profile that lookup fails and every
    video transcode returns HTTP 400 ("unable to find a matching
    profile"), which the app shows as "Playback Error".

    Modelled on the shipped Samsung Tizen profile, trimmed to what this
    app actually declares support for.
  -->
  <Settings>
    <!-- Let the app pick a non-first audio track without forcing a transcode. -->
    <Setting name="DirectPlayStreamSelection" value="true" />
  </Settings>
  <TranscodeTargets>
    <VideoProfile protocol="hls" container="mpegts" codec="h264" audioCodec="aac,mp2,mp3,ac3,eac3" context="streaming">
      <Setting name="BreakNonKeyframes" value="true" />
      <Setting name="IncludeMapInEmptyVTT" value="true" />
    </VideoProfile>
    <!-- Remux into mkv over plain HTTP: avoids re-encoding when only the
         container is the problem. -->
    <VideoProfile protocol="http" container="mkv" codec="h264" audioCodec="aac,mp3,ac3,eac3" context="streaming" />
    <VideoProfile container="mp4" codec="h264" audioCodec="aac,mp3" context="static" />
    <MusicProfile container="mp3" codec="mp3" />
    <PhotoProfile container="jpeg" />
  </TranscodeTargets>
  <DirectPlayProfiles>
    <!-- Conservative: only mp4/h264, the combination this set has been
         observed playing directly. mkv is left to transcode/remux. -->
    <VideoProfile container="mp4" codec="h264,mpeg4" audioCodec="aac,mp3,ac3,eac3" subtitleFormat="srt" />
    <MusicProfile container="mp4" codec="aac" />
    <MusicProfile container="mp3" codec="mp3" />
    <PhotoProfile container="jpeg,gif,png" />
  </DirectPlayProfiles>
  <CodecProfiles>
    <VideoCodec name="h264">
      <Limitations>
        <UpperBound name="video.width" value="1920" isRequired="true" />
        <UpperBound name="video.height" value="1080" isRequired="true" />
        <UpperBound name="video.bitDepth" value="8" />
      </Limitations>
    </VideoCodec>
    <VideoAudioCodec name="ac3,eac3,aac,mp3">
      <Limitations>
        <UpperBound name="audio.channels" value="6" />
      </Limitations>
    </VideoAudioCodec>
  </CodecProfiles>
</Client>
